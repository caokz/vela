{
  "manifest_version": 3,
  "name": "Vela",
  "description": "自定义 LLM 供应商的 AI 聊天助手：网页总结、网页翻译、划词就地翻译/代码解释、会话自带网页上下文",
  "version": "0.8.0",
  "web_accessible_resources": [
    {
      "resources": [
        "src/sidepanel/*",
        "src/page/tx-runner.html",
        "src/page/sel-panel.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "contextMenus",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Vela"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "options_ui": {
    "open_in_tab": true,
    "page": "src/options/options.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+M",
        "mac": "Command+M"
      }
    },
    "open-chat-tab": {
      "description": "打开独立聊天页",
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "Command+Shift+M"
      }
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "key": ""
}
